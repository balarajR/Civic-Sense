# Dependencies (re-installed inside Docker)
node_modules/

# Built output (rebuilt inside Docker)
dist/

# Secrets — never bake into image
.env
.env.*
!.env.example

# Git history
.git/
.gitignore

# CI/CD config (not needed at runtime)
.github/

# Test artifacts (not needed at runtime)
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
src/test/

# Editor and OS files
.vscode/
.idea/
*.DS_Store
*.log

# Docs
README.md
