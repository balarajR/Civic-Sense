rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Public election data — read-only, no writes from clients
    match /elections/{electionId} {
      allow read: if true;
      allow write: if false;
    }

    // Constituency data — read-only
    match /constituencies/{constituencyId} {
      allow read: if true;
      allow write: if false;
    }

    // User sessions — authenticated users can only access their own data
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
    }

    // Quiz results — authenticated users can create/read their own
    match /quizResults/{resultId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'score', 'timestamp']);
    }
  }
}
